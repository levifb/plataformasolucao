# Copie este arquivo para ".env" e preencha com os valores reais.
# O .env não é versionado no git — é onde ficam as credenciais.

# Servidor de email (com EMAIL_HOST definido, o envio real é ativado)
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=senha-de-app-de-16-letras
DEFAULT_FROM_EMAIL=Curso Solução <seu-email@gmail.com>

# ---- Apenas em produção (no servidor) ----
# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# SECRET_KEY=cole-a-chave-gerada-aqui
# DEBUG=False
# ALLOWED_HOSTS=seuusuario.pythonanywhere.com
# SITE_URL=https://seuusuario.pythonanywhere.com
